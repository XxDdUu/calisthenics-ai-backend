# ==============================================================================
# Calisthenics AI - Production Environment Variables Template
# ==============================================================================
# Copy this file to .env.prod on your production deployment target.
# Never commit the actual .env.prod file to version control.

# Database Credentials (Mandatory)
POSTGRES_DB=calisthenics_db
POSTGRES_USER=postgres
DB_PASSWORD=replace_with_strong_production_database_password

# JWT Security (Mandatory - must be 256-bit / min 32 chars)
JWT_SECRET=replace_with_cryptographically_secure_random_256_bit_secret
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Container Images (Tagged with Git Commit SHA or latest)
BACKEND_IMAGE=ghcr.io/xxdduu/calisthenics-ai-backend:latest
AI_SERVICE_IMAGE=ghcr.io/xxdduu/calisthenics-ai-service:latest

# Host Port Mapping (Changed to 8082 to prevent conflict with code-server on 8080)
HOST_PORT=8082

# AI Computer Vision Service
AI_SERVICE_TIMEOUT_SECONDS=60
MODEL_PATH=yolov8n-pose.pt
AI_DEVICE=cpu

# File Storage
STORAGE_MAX_FILE_SIZE=100MB

# Firebase Authentication (Optional)
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=classpath:firebase-service-account.json

# SMTP Email Configuration for Password Reset
MAIL_USERNAME=your_smtp_email@gmail.com
MAIL_APP_PASSWORD=your_smtp_app_password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# Google OAuth Client ID
GOOGLE_CLIENT_ID=610669602436-6vga6qoca1iefspli4o28ets4fgkv68j.apps.googleusercontent.com

