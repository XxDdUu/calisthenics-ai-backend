# ==============================================================================
# Calisthenics AI - Production Environment Variables Template
# ==============================================================================
# Copy this file to .env.prod on your production deployment target.
# Never commit the actual .env.prod file to version control.

# Database Credentials (Mandatory)
POSTGRES_DB=calisthenics_db
POSTGRES_USER=postgres
DB_PASSWORD=replace_with_strong_production_database_password

# JWT Security (Mandatory - must be 256-bit / min 32 chars)
JWT_SECRET=replace_with_cryptographically_secure_random_256_bit_secret
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Container Images (Tagged with Git Commit SHA or latest)
BACKEND_IMAGE=ghcr.io/xxdduu/calisthenics-ai-backend:latest
AI_SERVICE_IMAGE=ghcr.io/xxdduu/calisthenics-ai-service:latest

# Host Port Mapping (Changed to 8082 to prevent conflict with code-server on 8080)
HOST_PORT=8082

# AI Computer Vision Service
AI_SERVICE_TIMEOUT_SECONDS=60
MODEL_PATH=yolov8n-pose.pt
AI_DEVICE=cpu

# Media File Storage Configuration (local or minio)
STORAGE_PROVIDER=minio
STORAGE_MAX_FILE_SIZE=100MB

# MinIO Object Storage Configuration
# Root credentials (Admin)
MINIO_ROOT_USER=replace_with_minio_admin_username
MINIO_ROOT_PASSWORD=replace_with_minio_admin_strong_password

# Web Console Access (strictly localhost on VPS, connect via SSH port forward or Cloudflare)
MINIO_CONSOLE_HOST_BIND=127.0.0.1
MINIO_CONSOLE_PORT=9001

# MinIO Service Accounts (Generated with least privilege)
# Backend Service Account (Full access to all 4 calisthenics buckets)
MINIO_BACKEND_ACCESS_KEY=calisthenics-backend-prod
MINIO_BACKEND_SECRET_KEY=replace_with_backend_minio_secret_key

# AI Service Account (Restricted to analysis-media bucket only)
MINIO_AI_ACCESS_KEY=calisthenics-ai-prod
MINIO_AI_SECRET_KEY=replace_with_ai_minio_secret_key

# Public URL for Presigned / Public Object Downloads via Backend Proxy or Tunnel
MINIO_EXTERNAL_URL=https://api.sky-enterprise.id.vn/api/v1/storage

# Firebase Authentication (Optional)
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=classpath:firebase-service-account.json

# SMTP Email Configuration for Password Reset
MAIL_USERNAME=your_smtp_email@gmail.com
MAIL_APP_PASSWORD=your_smtp_app_password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# Google OAuth Client ID
GOOGLE_CLIENT_ID=610669602436-6vga6qoca1iefspli4o28ets4fgkv68j.apps.googleusercontent.com

# Gemini AI Integration (Workout Planner & Workout Performance Summary)
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=30

