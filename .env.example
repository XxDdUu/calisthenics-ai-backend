# Application Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=calisthenics_db
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword

# JWT Security Configuration
# Must be at least 256 bits (32 characters / base64 string)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Calisthenics AI FastAPI Service Configuration
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_SECONDS=60

# Media File Storage Configuration
STORAGE_LOCATION=./uploads
STORAGE_MAX_FILE_SIZE=100MB

# Firebase Authentication Configuration
FIREBASE_ENABLED=true
FIREBASE_CREDENTIALS_PATH=classpath:firebase-service-account.json

# SMTP email for password reset (Gmail App Password)
MAIL_USERNAME=
MAIL_APP_PASSWORD=
# Optional overrides for non-Gmail SMTP providers
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# Google Authentication Configuration
GOOGLE_CLIENT_ID=
