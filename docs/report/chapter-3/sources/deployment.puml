@startuml
!theme plain
skinparam defaultFontName Arial
skinparam roundCorner 10
skinparam shadowing false

skinparam node {
    BackgroundColor #F8FAFC
    BorderColor #334155
    FontColor #0F172A
}

skinparam component {
    BackgroundColor #EFF6FF
    BorderColor #1D4ED8
    FontColor #1E3A8A
}

skinparam database {
    BackgroundColor #F0FDF4
    BorderColor #15803D
    FontColor #14532D
}

node "<<Thiết bị Người dùng>>\nSmartphone Android (API 26+)" as MobileNode {
    artifact "CalisthenicsApp.apk" as AndroidApp <<executable>> {
        component "Jetpack Compose UI & Material 3" as UIComp
        component "Retrofit REST & OkHttp STOMP Client" as NetComp
        component "EncryptedSharedPreferences (TokenManager)" as SecStore
    }
}

node "<<Mạng Biên Đám Mây>>\nCloudflare Edge Network" as CFNode {
    component "Cloudflare Edge DNS & TLS Termination\n(api.sky-enterprise.id.vn)" as CFEdge
}

node "<<Máy chủ Ảo Cá nhân (VPS)>>\nUbuntu 22.04.5 LTS (Host: fourier)" as VPSNode {
    
    node "<<Hệ điều hành Host>>" as HostOS {
        component "cloudflared.service\n(Cloudflare Tunnel Daemon)\nTunnel ID: d7223a50-...-e7a149c7e21a" as CloudflaredService
    }

    node "<<Hạ tầng Docker Engine>>\nDocker Compose Network (Bridge)" as DockerNet {

        node "<<Docker Container: calisthenics-backend>>\nSpring Boot 3.2.12 (OpenJDK 21)" as BackendContainer {
            component "CalisthenicsBackendApplication.jar" as BackendApp
            component "Spring Security & JWT Filter" as SecFilter
            component "Flyway Database Migration Engine" as FlywayEngine
        }

        node "<<Docker Container: calisthenics-ai-service>>\nFastAPI (Python 3.11-slim)" as AIContainer {
            component "Uvicorn ASGI Server" as UvicornApp
            component "YOLOv8-Pose Engine (yolov8n-pose.pt)" as YOLOComp
            component "Biomechanical Analyzers" as BioComp
        }

        node "<<Docker Container: calisthenics-postgres>>\nPostgreSQL 16 Alpine" as DBContainer {
            database "calisthenics_db\n(Relational Schema V1-V22 & JSONB)" as RelDB
        }
    }

    storage "<<Persistent Docker Volumes>>" as Volumes {
        folder "postgres_data\n(/var/lib/postgresql/data)" as DBVolume
        folder "media_uploads\n(/app/uploads)" as MediaVolume
    }
}

' Kết nối mạng
MobileNode -- CFNode : "HTTPS / WSS (Port 443)\nTLS 1.3 Encrypted"
CFNode -- CloudflaredService : "Outbound Cloudflare Tunnel Connection\n(Zero Trust Ingress, Không mở port công khai)"
CloudflaredService -- BackendContainer : "Reverse Proxy nội bộ\nhttp://localhost:8082 -> :8080"

BackendContainer -- AIContainer : "Docker Network Internal HTTP\nhttp://ai-service:8000"
BackendContainer -- DBContainer : "JDBC Connection Pool (HikariCP)\npostgres:5432 / TCP"

DBContainer ..> DBVolume : "<<mount>>"
BackendContainer ..> MediaVolume : "<<mount>>"

@enduml
